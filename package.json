{
  "name": "disruptioniq",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -p \"[{name}]\" -n \"api,web,solver,vision\" -c \"blue,green,magenta,yellow\" \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:solver\" \"npm run dev:vision\"",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:solver": "python -m uvicorn main:app --app-dir services/solver --reload --port 8000",
    "dev:vision": "python -m uvicorn main:app --app-dir services/vision --reload --port 8010",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run && npm run solver:test && npm run vision:test",
    "solver:test": "python -m pytest services/solver/tests",
    "vision:test": "python -m pytest services/vision/tests",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "db:start": "node scripts/db-start.mjs",
    "db:seed": "npx tsx scripts/seed.ts",
    "seed:investigation": "npx tsx scripts/seed-investigation.ts",
    "db:reset": "npx tsx scripts/reset.ts",
    "scan:placeholders": "node scripts/scan-placeholders.mjs",
    "stress": "npx tsx scripts/run-stress.ts",
    "redteam": "npx tsx scripts/run-redteam.ts",
    "scenario:a": "npx tsx scripts/run-scenario-a.ts",
    "demo:reset": "npx tsx scripts/reset.ts",
    "demo:warm": "npx tsx scripts/demo-warm.ts",
    "metrics": "npx tsx scripts/metrics.ts",
    "acceptance": "vitest run apps/api/test/step16-acceptance.test.ts",
    "ml:train": "python services/ml/simulate_history.py && python services/ml/train.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3"
  }
}
